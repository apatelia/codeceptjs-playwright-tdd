{
  "name": "codeceptjs-playwright-tdd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "pnpm codeceptjs run --reporter=mocha-multi",
    "test:parallel": "pnpm codeceptjs run-workers 3",
    "test:multi-browsers": "pnpm codeceptjs run-multiple all",
    "test:tag": "pnpm codeceptjs run --reporter=mocha-multi --grep ",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint . --fix"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "@codeceptjs/examples": "^1.2.4",
    "@codeceptjs/ui": "^1.2.4",
    "@eslint/js": "^9.29.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/node": "^24.0.4",
    "codeceptjs": "^3.7.3",
    "codeceptjs-chai": "^2.3.5",
    "eslint": "^9.29.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.2.0",
    "mocha-multi": "^1.1.7",
    "mochawesome": "^7.1.3",
    "playwright": "^1.53.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
