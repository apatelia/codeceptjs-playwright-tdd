{
  "name": "codeceptjs-playwright-tdd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npx codeceptjs run --reporter=mocha-multi",
    "test:parallel": "npx codeceptjs run-workers 3",
    "test:multi-browsers": "npx codeceptjs run-multiple all",
    "test:tag": "npx codeceptjs run --reporter=mocha-multi --grep ",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.1",
    "@codeceptjs/examples": "^1.2.4",
    "@codeceptjs/ui": "^1.2.0",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/node": "^22.10.6",
    "codeceptjs": "^3.6.10",
    "codeceptjs-chai": "^2.3.5",
    "eslint": "^9.18.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "mocha-multi": "^1.1.7",
    "mochawesome": "^7.1.3",
    "playwright": "^1.49.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
